  <ItemGroup>
    <ProjectReference Include="..\..\core\SyncEngine.Abstractions\SyncEngine.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\SyncEngine.Providers.Oracle\SyncEngine.Providers.Oracle.csproj" />
  </ItemGroup>

</Project>
