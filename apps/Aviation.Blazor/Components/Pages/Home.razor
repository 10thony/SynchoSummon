@page "/"
@rendermode InteractiveServer
@using Aviation.Blazor.Services
@using Aviation.Shared.Entities
@using SyncEngine.Abstractions.Auth
@using SyncEngine.Abstractions.Client
@inject FacilityViewService Facilities
@inject ISyncSession SyncSession
@inject ISyncCredentialStatus CredentialStatus
@implements IDisposable

<PageTitle>Aviation Sync</PageTitle>

<h1>Aviation Sync (Blazor)</h1>
<p>Live facilities mirrored via SyncEngine deltas + SignalR wake.</p>

@{
    var snapshot = SyncSession.Snapshot;
}

<div class="sync-bar">
    <span class="sync-pill sync-pill-@StatusClass" title="@Facilities.StatusMessage">
        <span class="sync-dot"></span>
        @StatusLabel
    </span>
    @if (Facilities.LastUpdateUtc is { } last)
    {
        <span class="sync-meta">Updated @FormatAge(last) ago</span>
    }
    <span class="sync-meta">
        Cached rows: <strong>@Facilities.CachedCount</strong>
        (showing first @_items.Count)
    </span>
    @if (snapshot.OutboxPhase is SyncOutboxPhase.Pending or SyncOutboxPhase.Flushing && snapshot.OutboxPendingCount is > 0)
    {
        <span class="sync-meta outbox-indicator">
            <span class="sync-dot outbox-dot"></span>
            @snapshot.OutboxPendingCount pending write@(snapshot.OutboxPendingCount == 1 ? "" : "s")
        </span>
    }
    @if (snapshot.Phase is SyncSessionPhase.CatchingUp && snapshot.CatchUpAppliedCount is > 0)
    {
        <span class="sync-meta">Catching up (@snapshot.CatchUpAppliedCount changes applied)</span>
    }
    <a href="http://localhost:5080/telemetry" target="_blank" rel="noopener">Open telemetry dashboard</a>
</div>

@if (_credentialExpired)
{
    <div class="sync-auth-cta">
        Session expired — please re-authenticate.
    </div>
}

@if (Facilities.Status == FacilityViewSyncStatus.Offline)
{
    <div class="sync-offline-cta">
        You're offline. Changes will sync when connected.
    </div>
}

@if (Facilities.LastConflictMessage is { } conflict)
{
    <div class="sync-conflict">
        <span>@conflict</span>
        <button class="btn btn-sm" @onclick="DismissConflict">Dismiss</button>
    </div>
}

<div class="actions">
    <button class="btn" @onclick="OnRefreshClickedAsync" disabled="@_refreshing">Refresh</button>
    <button class="btn" @onclick="AddFacility">Add facility</button>
</div>

<table>
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>City</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
    @if (!_initialized)
    {
        <tr><td colspan="4" class="facilities-loading">
            <span class="loading-spinner"></span> Loading facilities…
        </td></tr>
    }
    else if (_items.Count == 0)
    {
        <tr><td colspan="4" class="facilities-empty">
            No facilities synced yet. Add one or wait for sync to complete.
        </td></tr>
    }
    else
    {
        @foreach (var facility in _items)
        {
            <tr @key="facility.FacilityId" class="@(Facilities.IsOptimistic(facility.FacilityId) ? "row-pending" : "")">
                <td>
                    @facility.FacilityCode
                    @if (Facilities.IsOptimistic(facility.FacilityId))
                    {
                        <span class="pending-marker"> (pending)</span>
                    }
                </td>
                <td>@facility.Name</td>
                <td>@facility.City, @facility.StateCode</td>
                <td>@facility.OperationalStatus</td>
            </tr>
        }
    }
    </tbody>
</table>

<style>
    .sync-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        margin: 0.5rem 0 1rem;
        font-size: 0.9rem;
    }

    .sync-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        font-weight: 600;
        line-height: 1.4;
    }

    .sync-dot {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 50%;
        background: currentColor;
    }

    .sync-pill-live { background: #e6f6ea; color: #197a3a; }
    .sync-pill-syncing { background: #fff5d6; color: #8a6400; }
    .sync-pill-syncing .sync-dot { animation: sync-pulse 1s ease-in-out infinite; }
    .sync-pill-offline { background: #f0f0f0; color: #555; }
    .sync-pill-error { background: #fde3e3; color: #a1241f; }
    .sync-pill-initializing { background: #e6ecf5; color: #2a4a7f; }

    @@keyframes sync-pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.3; }
    }

    .sync-meta { color: #555; }
    .actions { display: flex; gap: 0.5rem; margin-bottom: 1rem; }

    .facilities-loading { text-align: center; padding: 2rem; }
    .loading-spinner {
        display: inline-block;
        width: 1rem;
        height: 1rem;
        border: 2px solid #ccc;
        border-top-color: #333;
        border-radius: 50%;
        animation: spin 0.6s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .facilities-empty { font-style: italic; color: #777; padding: 1rem; text-align: center; }

    .sync-conflict {
        background: #fff3cd;
        color: #856404;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        margin: 0.5rem 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sync-offline-cta {
        background: #f0f0f0;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        margin: 0.5rem 0;
        text-align: center;
    }

    .sync-auth-cta {
        background: #fde3e3;
        color: #a1241f;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        margin: 0.5rem 0;
        text-align: center;
        font-weight: 600;
    }

    .pending-marker { color: #8a6400; font-style: italic; }

    .row-pending { background: #fffbe6; }

    .outbox-indicator { color: #8a6400; font-weight: 600; }
    .outbox-dot { background: #d4a017; animation: sync-pulse 1s ease-in-out infinite; }

    .btn-sm { padding: 0.2rem 0.5rem; font-size: 0.8rem; }
</style>

@code {
    private List<Facility> _items = [];
    private bool _initialized;
    private bool _credentialExpired;
    private readonly UiRefreshCoalescer _refresh = new();

    private bool _refreshing => _refresh.Current is not UiRefreshCoalescer.Phase.Idle;

    private string StatusLabel => Facilities.Status switch
    {
        FacilityViewSyncStatus.Live => "Live",
        FacilityViewSyncStatus.Syncing => "Syncing…",
        FacilityViewSyncStatus.CatchingUp => "Catching up…",
        FacilityViewSyncStatus.Offline => "Offline",
        FacilityViewSyncStatus.Reconnecting => "Reconnecting…",
        FacilityViewSyncStatus.Error => "Error",
        _ => "Initializing…",
    };

    private string StatusClass => Facilities.Status switch
    {
        FacilityViewSyncStatus.Live => "live",
        FacilityViewSyncStatus.Syncing => "syncing",
        FacilityViewSyncStatus.CatchingUp => "syncing",
        FacilityViewSyncStatus.Offline => "offline",
        FacilityViewSyncStatus.Reconnecting => "syncing",
        FacilityViewSyncStatus.Error => "error",
        _ => "initializing",
    };

    protected override void OnInitialized()
    {
        Facilities.Changed += OnChanged;
        Facilities.StatusChanged += OnStatusChanged;
        CredentialStatus.CredentialStateChanged += OnCredentialStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshAsync();
        }
    }

    private void OnChanged() => _ = InvokeAsync(RefreshAsync);

    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnCredentialStateChanged(SyncCredentialState state)
    {
        _credentialExpired = state == SyncCredentialState.Expired;
        _ = InvokeAsync(StateHasChanged);
    }

    private Task OnRefreshClickedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        if (!_refresh.TryBegin())
        {
            return;
        }

        try
        {
            do
            {
                var items = await Task.Run(() => Facilities.GetFacilities(100).ToList());
                _items = items;
                _initialized = true;
                StateHasChanged();
            }
            while (_refresh.ConsumeDirty());
        }
        catch (Exception)
        {
            _initialized = true;
            StateHasChanged();
        }
        finally
        {
            _refresh.End();
        }
    }

    private async Task AddFacility()
    {
        var id = Guid.NewGuid().ToString("N")[..8];
        await Facilities.UpsertOptimisticAsync(new Facility
        {
            FacilityId = $"fac-{id}",
            FacilityCode = $"X{id[..3]}".ToUpperInvariant(),
            Name = $"Demo Facility {id}",
            FacilityTypeCode = "AIRPORT",
            City = "Cedar Rapids",
            StateCode = "IA",
            ZipCode = "52404",
            Latitude = 41.8847m,
            Longitude = -91.7108m,
        });
    }

    private void DismissConflict() => Facilities.DismissConflict();

    private static string FormatAge(DateTime utc)
    {
        var age = DateTime.UtcNow - utc;
        if (age.TotalSeconds < 1) return "just now";
        if (age.TotalSeconds < 60) return $"{(int)age.TotalSeconds}s";
        if (age.TotalMinutes < 60) return $"{(int)age.TotalMinutes}m";
        return $"{(int)age.TotalHours}h";
    }

    public void Dispose()
    {
        Facilities.Changed -= OnChanged;
        Facilities.StatusChanged -= OnStatusChanged;
        CredentialStatus.CredentialStateChanged -= OnCredentialStateChanged;
    }
}
