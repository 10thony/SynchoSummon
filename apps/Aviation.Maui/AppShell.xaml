<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Aviation.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Aviation.Maui"
    Shell.FlyoutBehavior="Disabled"
    Title="Aviation Sync">

    <TabBar>
        <ShellContent
            Title="Facilities"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Equipment"
            ContentTemplate="{DataTemplate local:EquipmentPage}"
            Route="EquipmentPage" />

        <ShellContent
            Title="Logs"
            ContentTemplate="{DataTemplate local:MaintenanceLogPage}"
            Route="MaintenanceLogPage" />
    </TabBar>

</Shell>
